  "localized_copy": [
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_001",
      "fields": {
        "level_label": "LEVEL 6:",
        "title": "Construction Noise",
        "key_label": "KEY ACQUIRED:",
        "key_acquired": "GRIT",
        "objective_label": "MISSION OBJECTIVE",
        "objective": "Understanding that feeling 'stupid' is actually just the sound of heavy machinery hacking a path through your Brain Jungle.",
        "status_label": "LOADING MAP ASSETS... [COMPLETED]"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_002",
      "fields": {
        "story_heading": "CONSTRUCTION NOISE",
        "log_label": "SYSTEM LOG >>",
        "text": "Saturday morning. The tower crashed. Again. Alio kicked the blocks across the room. A red square landed with a plop in the cat's water bowl. The cat looked highly offended and left the room."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_003",
      "fields": {
        "speaker_label": "ALIO",
        "text": "I QUIT! I'm too stupid! This tower hates me! Physics is a bully!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_004",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Mimi burst into the room, holding a basket of laundry. She set it down heavily and pressed her hands flat against her thighs to ground herself before dealing with the chaos. 'Pause! Who is screaming? Alio, stop destroying the floor! Why are you acting like a tornado?'"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_005",
      "fields": {
        "speaker_label": "ALIO",
        "text": "Because my brain hurts! I'm trying to build the Super-Helix, but my hands won't listen to my brain!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_006",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Mimi dropped the laundry basket on Dilo, who was sneaking in with a carrot."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_007",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Dilo, stay. Alio, listen. Your brain hurts because you are in a Jungle."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_008",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Alio froze, holding a blue block like a weapon. 'A jungle? A... are there snakes? Dilo said if I think too hard, a brain-snake will crawl out of my ear!'\n\nDilo peeked out from under a pair of pants, crunching his carrot."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_009",
      "fields": {
        "speaker_label": "DILO",
        "text": "It's true. I see a tail. It's sticking out of your left ear. Oh, wait, it's wiggling."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_010",
      "fields": {
        "speaker_label": "ALIO",
        "text": "Pull it out! Pull it out! Mammi! It's hissing!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_011",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Luli, lying on the rug, didn't look up from her book."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_012",
      "fields": {
        "speaker_label": "LULI",
        "text": "Alio, relax. That's Mammi spraying air freshener because Dilo took his shoes off. And honestly, the snake smells better than Dilo's feet."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_013",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Alio, look at me. There are no snakes. But your brain IS a jungle full of thick vines. When you try something new (like this tower), you have to hack a path through the vines. It is heavy work. It makes you sweat. It makes your head feel tight. That feeling isn't 'stupid'. That feeling is Construction Noise."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_014",
      "fields": {
        "speaker_label": "ALIO",
        "text": "So... I'm not broken?"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_015",
      "fields": {
        "speaker_label": "MIMI",
        "text": "No. You are just holding a heavy machete. The first time you walk the path, it's hard. The tenth time, the vines are gone and it's a highway. But you have to hack the vines first."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_016",
      "fields": {
        "speaker_label": "ALIO",
        "text": "Okay. I will hack the vines. But... I think I need a nap first. The machete is heavy."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_017",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Smart. Sleep helps the workers pave the road."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_018",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Alio picked up his winter hat and pulled it over his ears. 'I'm sleeping in this. Just in case Dilo was 1% right about the snakes.'"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_019",
      "fields": {
        "file_label": "// FILE: SYSTEM NOTE",
        "note_label": "REMEMBER:",
        "text": "Struggle and frustration are not failure. They are simply the noise of heavy construction machinery in your head."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_020",
      "fields": {
        "page_heading": "THE NEURO-COACHING CONSOLE",
        "file_label": "// FILE: 016",
        "heading": "THE BRAIN SECRET (Brain Roads)",
        "science_label": "The Science:",
        "science": "This is Neuroplasticity. Your brain is full of neurons that want to hold hands. When you learn something hard, they have to stretch and connect through a 'thick jungle.' This uses a ton of energy (sugar and oxygen), which is why you feel tired or frustrated!",
        "in_story_label": "In The Story:",
        "in_story": "Alio yelled that his brain 'hurts' and feels 'fuzzy.' Mimi explained this is normal because he is 'hacking vines' (making new connections) in the jungle."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_021",
      "fields": {
        "file_label": "// FILE: 017",
        "heading": "THE TOOL ('The Power of YET')",
        "science_label": "The Science:",
        "science": "When you say 'I can't,' your brain stops releasing chemicals needed for learning. It gives up. When you add 'YET,' your brain stays open and keeps looking for a solution.",
        "in_story_label": "In The Story:",
        "in_story": "Alio shouted 'I'm too stupid!' (Fixed Mindset). He should have said: 'I haven't figured out the Super-Helix YET.' That means the road is under construction, not closed!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_006_node_022",
      "fields": {
        "file_label": "// FILE: 018",
        "heading": "THE GLITCH ('Save The File')",
        "science_label": "The Science:",
        "science": "If you try and try and still can't do it, stop! Your brain needs sleep to 'glue' the new connections together. This is called Consolidation.",
        "in_story_label": "In The Story:",
        "in_story": "Alio decided to take a nap because 'the machete is heavy.' This was actually brilliant! While he sleeps (even in his winter hat), his brain will turn that rough jungle path into a smoother road for tomorrow."
      }
    },
