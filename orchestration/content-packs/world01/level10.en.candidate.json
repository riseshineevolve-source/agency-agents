  "localized_copy": [
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_001",
      "fields": {
        "level_label": "LEVEL 10:",
        "title": "The Energy Vampire",
        "key_label": "KEY ACQUIRED:",
        "key_acquired": "ENERGY",
        "objective_label": "MISSION OBJECTIVE",
        "objective": "Defeating the Energy Vampire by eating a metaphorical ugly frog.",
        "status_label": "LOADING MAP ASSETS... [COMPLETED]"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_002",
      "fields": {
        "story_heading": "THE ENERGY VAMPIRE",
        "log_label": "SYSTEM LOG >>",
        "text": "It was 20:00. The Sunday Panic. Dilo ran aimlessly in circles, clutching his head. The entire weekend was gone."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_003",
      "fields": {
        "speaker_label": "DILO",
        "text": "No time! Battery 5%! I have math, geography, and I promised to clean my room! Why is the weekend only 4 minutes long?!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_004",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Mimi was standing in the middle of the room, holding a real sock. She rubbed her forehead, trying to find her own Wizard in the mess."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_005",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Dilo, stop running! You spent 4 hours organizing digital socks, but your real socks are on the floor!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_006",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Meanwhile, Luli was calmly eating an apple in the eye of the storm. She pointed under the kitchen table."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_007",
      "fields": {
        "speaker_label": "LULI",
        "text": "Um, Mammi? Why is Alio wearing his bicycle helmet inside?"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_008",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Mimi lifted the tablecloth. Alio was curled up in a ball, helmet strapped tight, holding a flashlight."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_009",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Alio?"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_010",
      "fields": {
        "speaker_label": "ALIO",
        "text": "Shhh! Dilo said the Energy Vampire comes at 20:00. He sucks the juice right out of the top of your head! I don't want to be a dead battery! I want to keep my juice!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_011",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Mimi sighed, pulling Alio out by his foot."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_012",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Alio, take off the helmet. Dilo is talking nonsense. But... he is right about the Vampire. The Vampire is called Brain Drain."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_013",
      "fields": {
        "speaker_label": "ALIO",
        "text": "Brain Drain? Is that a monster with fangs?"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_014",
      "fields": {
        "speaker_label": "MIMI",
        "text": "It's when you worry. Dilo started the day with 100% Battery. But every time he looked at his homework and said 'Not now,' it cost him 10% energy. He wasted his whole battery worrying about the work, not doing it. Now he has to fight the Boss Level with only 5% power."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_015",
      "fields": {
        "speaker_label": "LULI",
        "text": "Next time, you have to Eat the Frog in the morning."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_016",
      "fields": {
        "speaker_label": "ALIO",
        "text": "A FROG?! A real, green, slimy frog?! I have to eat it for breakfast?! NOOOO!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_017",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "He tried to put his helmet back on."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_018",
      "fields": {
        "speaker_label": "LULI",
        "text": "A metaphorical frog, you nugget! The Frog is the hard task. Like math. Or cleaning."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_019",
      "fields": {
        "speaker_label": "ALIO",
        "text": "Aaa. That makes sense. Homework is disgusting like frogs. I would rather eat the frog than let the Vampire steal my juice."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_020",
      "fields": {
        "file_label": "// FILE: SYSTEM_TIPS",
        "note_label": "SYSTEM TIP:",
        "text": "Do the hard thing in the morning, and you will save your energy (and you won't need a helmet)."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_021",
      "fields": {
        "page_heading": "THE NEURO-COACHING CONSOLE",
        "file_label": "// FILE: 028",
        "heading": "THE BRAIN SECRET (Brain Drain)",
        "science_label": "The Science:",
        "science": "You have a limited amount of 'Willpower Fuel' each day. Scientists call this Decision Fatigue. Every time you look at a task and decide not to do it, you burn fuel.",
        "in_story_label": "In The Story:",
        "in_story": "Dilo spent all day playing games and avoiding his chores. By 20:00, he hadn't done the work, but he was exhausted anyway! Why? Because 'avoiding' takes as much energy as 'doing.'"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_022",
      "fields": {
        "file_label": "// FILE: 029",
        "heading": "THE TOOL ('Eat The Frog')",
        "science_label": "The Science:",
        "science": "Your brain is freshest in the morning. If you do the hardest, ugliest task first ('Eating the Frog'), your brain releases Dopamine (relief!). The rest of the day feels easy because you aren't carrying a heavy frog in your pocket.",
        "in_story_label": "In The Story:",
        "in_story": "If Dilo had done his math (The Frog) at 10:00 AM, he would have had 100% battery for his digital socks later."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_010_node_023",
      "fields": {
        "file_label": "// FILE: 030",
