  "localized_copy": [
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_001",
      "fields": {
        "level_label": "LEVEL 8:",
        "title": "The Muddy Ferrari",
        "key_label": "KEY ACQUIRED:",
        "key_acquired": "SELF-CARE",
        "objective_label": "MISSION OBJECTIVE",
        "objective": "Washing your face is actually high-performance car maintenance.",
        "status_label": "LOADING MAP ASSETS... [COMPLETED]"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_002",
      "fields": {
        "story_heading": "THE MUDDY FERRARI",
        "log_label": "SYSTEM LOG >>",
        "text": "Sunday afternoon. Alio walked into the living room, looking like a swamp monster made of mud and orange snack dust. He left a trail of dirty footprints across Mimi's clean floor."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_003",
      "fields": {
        "speaker_label": "ALIO",
        "text": "I'm not washing! It's my tactical camouflage!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_004",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Luli wrinkled her nose and didn't even look up from her book."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_005",
      "fields": {
        "speaker_label": "LULI",
        "text": "You smell like a wet dog that rolled in old cheese."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_006",
      "fields": {
        "speaker_label": "ALIO",
        "text": "But Dilo said that dirt creates a protective shield against aliens. He said aliens only kidnap clean children because they smell like soap, and soap is a delicacy in their galaxy."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_007",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Luli finally looked up."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_008",
      "fields": {
        "speaker_label": "LULI",
        "text": "Dilo... your creativity in inventing nonsense is Nobel-worthy."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_009",
      "fields": {
        "speaker_label": "ALIO",
        "text": "So... if I wash, the aliens will eat me! I don't want to be a snack, Mammi!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_010",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Mimi walked in, holding a laundry basket. She grabbed Alio by the arm, holding him at a safe distance (because of the smell). She took a sharp breath through her nose, counting to three before speaking."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_011",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Alio. Aliens don't eat soap. Dilo smells like a gym locker that hasn't been opened in ten years, that's why he says that. He just doesn't want to shower."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_012",
      "fields": {
        "speaker_label": "DILO",
        "text": "Hey! I'm cultivating a natural microbiome!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_013",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Go to the bath. Listen to me: Your body is the only vehicle you get for life. If you treat it like a Ferrari - wash it, fuel it, rest it - it wins races. If you treat it like a trash can, it runs like a trash can."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_014",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Alio looked at the car poster on Dilo's wall, then at his own dirty hands."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_015",
      "fields": {
        "speaker_label": "ALIO",
        "text": "Promise? Do you have a license to fight aliens if they come for my clean skin?"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_016",
      "fields": {
        "speaker_label": "MIMI",
        "text": "I have a 'Mammi License'. That is a higher rank than a General."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_017",
      "fields": {
        "speaker_label": "ALIO",
        "text": "Okay. I'll risk it. But if they kidnap me, Dilo has to do my chores forever."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_018",
      "fields": {
        "file_label": "// FILE: SYSTEM NOTE",
        "note_label": "SYSTEM NOTE:",
        "text": "Soap is not a punishment, it's Ferrari maintenance."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_019",
      "fields": {
        "page_heading": "THE NEURO-COACHING CONSOLE",
        "file_label": "// FILE: 022",
        "heading": "THE BRAIN SECRET (The Superhero Suit)",
        "science_label": "The Science:",
        "science": "This is called 'Enclothed Cognition.' When you are clean and dressed in fresh clothes, your brain actually thinks sharper! Taking care of your body sends a secret text message to your brain saying: 'I matter. I am important.'",
        "in_story_label": "In The Story:",
        "in_story": "Alio wanted to stay dirty (Trash Can Mode), but Mimi explained that to 'win races' in life, you have to treat your body like a Ferrari. A shiny car drives better!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_020",
      "fields": {
        "file_label": "// FILE: 023",
        "heading": "THE TOOL ('The Power Pose')",
        "science_label": "The Science:",
        "science": "Your body language changes your brain chemistry. If you act brave with your body, your brain starts to feel brave.",
        "in_story_label": "In The Story:",
        "in_story": "Alio was slumping and hiding. Try this: Stand like a Superhero (hands on hips, chest out, chin up) for 2 minutes. It lowers stress and boosts confidence!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_021",
      "fields": {
        "file_label": "// FILE: 024",
        "heading": "THE GLITCH ('I feel lazy and gross')",
        "science_label": "The Science:",
        "science": "When you feel tired and grumpy, your nervous system is overheated. You need a reset button.",
        "in_story_label": "In The Story:",
        "in_story": "If Alio is too tired to wash, he can use the 'Seal Trick.' Splash cold water on your face. This triggers an ancient reflex (The Dive Reflex) that instantly slows your heart and wakes up your brain."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_022",
      "fields": {
        "page_heading": "QUEST",
        "heading": "TALK ABOUT IT",
        "in_story_label": "In The Story:",
        "in_story": "Dilo claimed he was 'cultivating a microbiome' (gross!).",
        "your_turn_label": "Your Turn:",
        "your_turn": "Are you treating your body like a Treasure or a Trash Can today? What makes you feel 'shiny' and ready?"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_023",
      "fields": {
        "reward_label": "XP REWARD",
        "heading": "FAMILY MISSION",
        "in_story_label": "In The Story:",
        "in_story": "Alio went to perform 'Ferrari Maintenance.'",
        "your_turn_label": "Your Turn:",
        "your_turn": "Treat yourself like a VIP guest tonight. Fresh pajamas, brushed teeth, clean face. Notice if you sleep better!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_008_node_024",
      "fields": {
        "file_label": "// FILE: BRAIN_HACK",
        "heading": "TOP SECRET SCIENCE (For Big and Small Brains)",
        "body": "Why does cold water work? Humans have a secret superpower called the Mammalian Dive Reflex. When cold water hits your nose and cheeks, your brain thinks you are diving underwater. It instantly slows down your heartbeat to save oxygen and calms you down. It is the fastest way to stop a panic attack or wake up from a slump!"
      }
