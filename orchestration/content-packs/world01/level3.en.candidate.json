  "localized_copy": [
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_001",
      "fields": {
        "level_label": "LEVEL 3:",
        "title": "The Invisible XP",
        "key_label": "KEY ACQUIRED:",
        "key_acquired": "PATIENCE",
        "objective_label": "MISSION OBJECTIVE",
        "objective": "Realizing that real life isn't 'broken' - it just has slow download speeds. Grinding is where the magic happens.",
        "status_label": "LOADING MAP ASSETS... [COMPLETED]"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_002",
      "fields": {
        "story_heading": "THE INVISIBLE XP",
        "log_label": "SYSTEM LOG >>",
        "text": "Wednesday afternoon. Dilo threw his soccer cleats at the wall. Thump. The wall shook. Dilo's face was completely red."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_003",
      "fields": {
        "speaker_label": "DILO",
        "text": "Retirement! Real life has too much lag. In the game, I'm a master. Here, I am... buffering. I quit."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_004",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Mimi walked in with a vacuum cleaner, tripping over the cleats. She turned it off. She closed her eyes for a second, took a deep, calming breath to stay focused, and sat on the edge of the bed."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_005",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Games cheat, Dilo. They give you gold coins just for walking. They TRICK your brain into feeling like a winner instantly. Real life makes you wait for the treasure."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_006",
      "fields": {
        "speaker_label": "DILO",
        "text": "I hate waiting. I practiced soccer for a whole week. And I still missed the goal. I want the win NOW. I'm filing a bug report on reality."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_007",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Mimi stroked his messy hair."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_008",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Dilo, look at me. Your body is your real Avatar. Every sprint, every drill... that is Invisible XP (Experience Points). You aren't just running; you are building tiny super-highways inside your brain. You just can't see the progress bar above your head yet."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_009",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Dilo rolled over."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_010",
      "fields": {
        "speaker_label": "DILO",
        "text": "So... I am leveling up? Even if I look like a confused penguin?"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_011",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Yes. You are just stuck in 'The Training Level.' It feels slow, but it's where the muscles are built. Only noobs quit during The Training Level. Pros know they have to grind to unlock the skills."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_012",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Dilo sighed and sat up. He looked at his cleats. Then he flopped back down."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_013",
      "fields": {
        "speaker_label": "DILO",
        "text": "Okay, I get the XP thing. But Mammi... I just can't. My legs feel like jelly. The sofa is pulling me in like a black hole. I can't practice for an hour."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_014",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Mimi tapped his nose."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_015",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Who said anything about an hour? That is too big. Your brain is scared of the big work."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_016",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "She picked up a cleat and tossed it to him."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_017",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Let's make a deal. Just go outside and juggle the ball for 10 minutes. Only 10 minutes. If you still hate it after that, you can come back and be a vegetable. Deal?"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_018",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Dilo caught the cleat."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_019",
      "fields": {
        "speaker_label": "DILO",
