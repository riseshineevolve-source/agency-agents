    {
      "locale": "en",
      "node_id": "world01_mission_003_node_024",
      "fields": {
        "page_heading": "THE NEURO-COACHING CONSOLE",
        "file_label": "// FILE: 007",
        "heading": "THE BRAIN SECRET (The Dopamine Trap)",
        "science_label": "The Science:",
        "science": "Video games give you 'Fast Dopamine' (instant treats). Real skills give you 'Slow Dopamine' (pride that comes later). Your brain is lazy. It wants the fast treat! But the slow treat lasts much longer.",
        "in_story_label": "In The Story:",
        "in_story": "Mimi explained that games 'cheat' by giving gold coins easily. Real life (soccer) is harder because the rewards (XP) are invisible at first."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_025",
      "fields": {
        "file_label": "// FILE: 008",
        "heading": "THE TOOL ('The 10-Minute Deal')",
        "science_label": "The Science:",
        "science": "The hardest part of any task is starting. This is called 'Friction.' Your brain thinks the work will be painful and huge. But if you make the task tiny, the brain says: 'Oh, I can do that!'",
        "in_story_label": "In The Story:",
        "in_story": "Dilo couldn't imagine practicing for an hour ('The sofa is a black hole'). But when Mimi said 'Just do 10 minutes,' his brain stopped being scared. And guess what? Once he started, he didn't want to stop!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_026",
      "fields": {
        "file_label": "// FILE: 009",
        "heading": "THE GLITCH ('The Training Level')",
        "science_label": "The Science:",
        "science": "When you make mistakes, you aren't failing. You are building Myelin. That's a fancy word for brain-insulation. It makes your thoughts faster.",
        "in_story_label": "In The Story:",
        "in_story": "Dilo thought he was a 'confused penguin.' Mimi corrected him: he was just in 'The Training Level.' Every time he missed the goal, his brain was actually learning how to aim better next time."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_003_node_027",
      "fields": {
        "page_heading": "QUEST",
        "heading": "TALK ABOUT IT",
        "in_story_label": "In The Story:",
        "in_story": "Dilo used a timer to trick his brain into starting.",
        "your_turn_label": "Your Turn:",
        "your_turn": "Is there something you are avoiding right now? What if you only did it for 5 minutes?"
      }
    },
