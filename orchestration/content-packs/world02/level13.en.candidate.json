  "localized_copy": [
    {
      "locale": "en",
      "node_id": "world02_mission_013_node_001",
      "fields": {
        "level_label": "LEVEL 13:",
        "title": "The Glitchy Wi-Fi",
        "key_label": "KEY ACQUIRED:",
        "key_acquired": "LISTENING",
        "objective_label": "MISSION OBJECTIVE",
        "objective": "Why we hear 'Blah Blah' when Mom says 'Shoes'.",
        "status_label": "LOADING MAP ASSETS... [COMPLETED]"
      }
    },
    {
      "locale": "en",
      "node_id": "world02_mission_013_node_002",
      "fields": {
        "story_heading": "THE GLITCHY WI-FI",
        "log_label": "SYSTEM LOG >>",
        "text": "The morning rush. Chaos level: Critical. Mimi stood in the kitchen, holding her car keys tightly, sweating a little in her winter coat."
      }
    },
    {
      "locale": "en",
      "node_id": "world02_mission_013_node_003",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Team, shoes on. Car. 5 minutes. We are late for school! Move it! Let's go, let's go!"
      }
    },
    {
      "locale": "en",
      "node_id": "world02_mission_013_node_004",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Silence. Absolute, completely calm silence. Dilo was sitting on the floor, intensely bouncing a soccer ball between his knees while staring at a gaming video on his phone. Nini was singing a very loud, made-up opera song to a spoon, complete with full dance moves and big jumps across the kitchen floor."
      }
    },
    {
      "locale": "en",
      "node_id": "world02_mission_013_node_005",
      "fields": {
        "speaker_label": "NINI",
        "text": "(Singing loudly, spinning like a top) Ohhhh, the shoes are looooost, the time is gooooone, the mother is crrryyying in despaaaaiiir!"
      }
    },
    {
      "locale": "en",
      "node_id": "world02_mission_013_node_006",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Alio was busy drawing building plans. He was trying to build a cool shoe-throwing machine out of rubber bands and a spatula so he wouldn't have to walk to the hallway.\n\n5 minutes later. Mimi angrily zipped up her coat to the top. She almost lost it, her face turning red. But then she stopped, closed her eyes, and spoke out loud to herself."
      }
    },
    {
      "locale": "en",
      "node_id": "world02_mission_013_node_007",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Stop. Rewind. Mom is calming down. I am not going to yell. I am going to restart the talking rule. Okay, launching! Go go go! We are leaving!"
      }
    },
    {
      "locale": "en",
      "node_id": "world02_mission_013_node_008",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "The kids looked up, totally confused and completely unready to leave. The soccer ball rolled away. The throwing machine shot a slipper into the sink."
      }
    },
    {
      "locale": "en",
      "node_id": "world02_mission_013_node_009",
      "fields": {
        "speaker_label": "ALIO",
        "text": "Go where? I'm naked!"
      }
    },
    {
      "locale": "en",
      "node_id": "world02_mission_013_node_010",
      "fields": {
        "speaker_label": "NINI",
        "text": "I can't find my shoes! My sparkly ones! Why didn't you warn us?! This is a surprise attack! My dance wasn't finished!"
      }
    },
    {
      "locale": "en",
      "node_id": "world02_mission_013_node_011",
      "fields": {
        "speaker_label": "MIMI",
        "text": "I warned you 5 minutes ago! I sent the signal loud and clear! I used words!"
      }
    },
    {
      "locale": "en",
      "node_id": "world02_mission_013_node_012",
      "fields": {
        "speaker_label": "DILO",
        "text": "I didn't get it! My Wi-Fi was off!"
      }
    },
    {
      "locale": "en",
      "node_id": "world02_mission_013_node_013",
      "fields": {
        "speaker_label": "MIMI",
        "text": "I can see that. You guys are in Airplane Mode. I am talking to the air. My Lizard is waking up and it wants to yell very loudly!"
      }
    },
    {
      "locale": "en",
      "node_id": "world02_mission_013_node_014",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Luli stepped into the kitchen like an army boss. She was fully dressed, shoes tied, backpack zipped up perfectly."
      }
    },
    {
      "locale": "en",
      "node_id": "world02_mission_013_node_015",
      "fields": {
        "speaker_label": "LULI",
        "text": "Captain, your radio channel is wrong. You are talking on FM, they are listening on AM. We need to use a new talking rule with a real check. We need the Echo Game. You guys are terrible at hearing things."
