  "localized_copy": [
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_001",
      "fields": {
        "level_label": "LEVEL 7:",
        "title": "The Bankrupt Plant",
        "key_label": "KEY ACQUIRED:",
        "key_acquired": "FRIENDSHIP",
        "objective_label": "MISSION OBJECTIVE",
        "objective": "Learning that friends prefer water and attention over cold, hard cash.",
        "status_label": "LOADING MAP ASSETS... [COMPLETED]"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_002",
      "fields": {
        "story_heading": "THE BANKRUPT PLANT",
        "log_label": "SYSTEM LOG >>",
        "text": "Saturday afternoon. Nini was crying over a dry, brown plant named Barnaby. It was a messy day, and Mimi was doing her tactical shoulder-taps to stay calm in the chaos."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_003",
      "fields": {
        "speaker_label": "NINI",
        "text": "'I'm bankrupt!' she wailed. 'Barnaby is crunchy! He was my best friend, but now he looks like a stick!'"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_004",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Mimi walked in and touched the dry soil."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_005",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Nini, did you water him? Or did you just sing songs to him?"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_006",
      "fields": {
        "speaker_label": "NINI",
        "text": "I... I forgot the water. I was busy drawing him a portrait."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_007",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Friendship isn't about portraits, Nini. It's like a Piggy Bank. Every time you listen or help, you put a coin IN (Deposit). Every time you ignore a friend, you take a coin OUT (Withdrawal). Barnaby is empty."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_008",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Suddenly, Alio marched into the room, shaking his plastic piggy bank. Clink, clink."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_009",
      "fields": {
        "speaker_label": "ALIO",
        "text": "Don't worry, Nini! I can save him! Eat the money, Barnaby! Be rich and happy!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_010",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Alio tried to shove a shiny coin into the plant's pot. Dilo swooped in from the hallway like a hawk."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_011",
      "fields": {
        "speaker_label": "DILO",
        "text": "Actually, Barnaby told me he prefers pizza. I will take this coin and buy him a slice. I'll eat it for him. It's a spiritual transfer."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_012",
      "fields": {
        "speaker_label": "MIMI",
        "text": "Dilo! Give it back! You cannot steal from a plant's charity fund!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_013",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Dilo grumbled, rolling his eyes."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_014",
      "fields": {
        "speaker_label": "DILO",
        "text": "Fine. No spiritual pizza. You guys have no vision."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_015",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "He tossed the coin back. Alio caught it and clutched it tight to his chest."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_016",
      "fields": {
        "speaker_label": "ALIO",
        "text": "Phew! Thanks, Mammi! I really need this. I'm saving for a helicopter to escape the mutant ants from the sidewalk. Do you think Barnaby can fly a helicopter too? Or should I buy him a tiny parachute?"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_017",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Nini wiped her eyes and hugged Alio."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_018",
      "fields": {
        "speaker_label": "NINI",
        "text": "Alio, you are the weirdest, sweetest brother. Barnaby doesn't need a parachute. He needs a drink."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_019",
      "fields": {
        "speaker_label": "ALIO",
        "text": "Quick! Operation: Water Bomb!"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_020",
      "fields": {
        "log_label": "SYSTEM LOG >>",
        "text": "Together, they grabbed the watering can. Water spilled everywhere. Barnaby didn't turn gold, but he stood a little straighter. True friendship is made of small deposits of kindness (and water), not gold coins."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_021",
      "fields": {
        "page_heading": "THE NEURO-COACHING CONSOLE",
        "file_label": "// FILE: 019",
        "heading": "THE BRAIN SECRET (The Magic Ratio)",
        "science_label": "The Science:",
        "science": "Friendships aren't built on big parties. They are built on tiny moments. Scientists found a 'Magic Number': It takes 5 nice things to fix 1 mean thing. Negativity is heavy!",
        "in_story_label": "In The Story:",
        "in_story": "Nini drew a portrait (nice), but she forgot to water Barnaby for days (mean/neglect). The 'Withdrawals' were bigger than the 'Deposits,' so the friendship dried up."
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_022",
      "fields": {
        "file_label": "// FILE: 020",
        "heading": "THE TOOL ('The Question Ball')",
        "science_label": "The Science:",
        "science": "Conversation is like a game of catch. If you hold the ball (talk only about yourself), the game stops. You have to throw it back!",
        "in_story_label": "In The Story:",
        "in_story": "Nini was busy 'singing and drawing' (doing her own thing) instead of looking at what Barnaby actually needed. To be a good friend, you have to ask: 'What do YOU need right now?'"
      }
    },
    {
      "locale": "en",
      "node_id": "world01_mission_007_node_023",
      "fields": {
        "file_label": "// FILE: 021",
        "heading": "THE GLITCH ('My friend is mean to me')",
        "science_label": "The Science:",
