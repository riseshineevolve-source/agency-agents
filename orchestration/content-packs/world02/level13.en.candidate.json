        "file_label": "// FILE: 039",
        "heading": "THE GLITCH ('I forgot!')",
        "science_label": "The Science:",
        "science": "Your 'Working Memory' (RAM) is small. If you get a list of 5 things to do, your brain crashes and only remembers the last one.",
        "correction_label": "Correction:",
        "correction": "Ask your Captain for one command at a time, or write it down on a Checklist (External RAM)."
      }
